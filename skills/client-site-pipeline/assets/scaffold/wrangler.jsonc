{
  // Cloudflare Workers, "static + API Worker" mode (see architecture-plan.md).
  // Pages are static assets from `astro build`; the Worker runs only for /api/*.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "{{WORKER_NAME}}",
  "main": "worker/index.ts",
  "compatibility_date": "{{DATE}}",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  // No database_id: the first `wrangler deploy` provisions the database.
  // The Worker applies migrations/0001_init.sql itself before its first write.
  "d1_databases": [{ "binding": "DB", "database_name": "{{WORKER_NAME}}", "migrations_dir": "migrations" }],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "vars": { "BRAND_NAME": "{{BUSINESS}}" },
  "observability": { "enabled": true }
}
