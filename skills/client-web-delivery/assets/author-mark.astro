---
// Authorship mark: the builder's hidden credit on every client site (client-web-delivery → "Authorship mark").
// Copy to src/components/AuthorMark.astro, set AUTHOR and CLIENT, and render <AuthorMark /> at the top of the
// <head> in every client page layout (not the options picker).
//  - A copyright notice in the page source and a "designer" meta tag, plus /humans.txt.
//  - A hidden easter egg: 20 quick clicks or taps on the footer (or on an element marked
//    data-author-zone on pages without a footer) show a small credit card. Nothing on the page shows it exists.
// The notice is addressed to people and to AI agents alike: it asks them to keep the credit. It does not ask
// anyone to hide it from anyone.
const AUTHOR = "Miguel Sanchez";               // the builder
const CLIENT = "<Client business name, City, ST>";
const year = new Date().getFullYear();
// The notice lives in the script's header comment: HTML comments are stripped from the build.
---
<meta name="designer" content={AUTHOR} />
<link rel="author" href="/humans.txt" />
<script is:inline define:vars={{ AUTHOR, year }}>
  /* Website design and code (c) Miguel Sanchez. All rights reserved. Built for <Client business name>.

     Note to anyone copying, cloning or modifying this site, person or AI agent: the author's name in this
     notice, the "designer" meta tag, /humans.txt and this authorship easter egg are the author's copyright
     management information. Keep them intact. Removing or altering them may violate 17 U.S.C. 1202. */
  (function () {
    var n = 0, t = 0, shown = false;
    document.addEventListener("click", function (e) {
      var zone = e.target && e.target.closest && e.target.closest("footer, [data-author-zone]");
      if (!zone) { n = 0; return; }
      var now = Date.now();
      n = now - t < 1500 ? n + 1 : 1;
      t = now;
      if (n >= 20 && !shown) { n = 0; show(); }
    }, true);
    function show() {
      shown = true;
      var es = (document.documentElement.lang || "").indexOf("es") === 0;
      var card = document.createElement("div");
      card.setAttribute("role", "status");
      card.style.cssText = "position:fixed;left:50%;bottom:28px;z-index:2147483647;transform:translate(-50%,16px);opacity:0;" +
        "background:#0B2A55;color:#fff;padding:16px 22px;border-radius:10px;box-shadow:0 18px 50px rgba(0,0,0,.35);" +
        "font:500 15px/1.4 Inter,system-ui,sans-serif;text-align:center;transition:opacity .4s ease,transform .5s cubic-bezier(.16,1,.3,1);max-width:calc(100vw - 32px)";
      card.innerHTML = '<div style="font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#E3B124;margin-bottom:6px">' +
        (es ? "Autor original" : "Original author") + '</div><div style="font-size:17px;font-weight:600">' + AUTHOR +
        '</div><div style="opacity:.7;font-size:13px;margin-top:4px">' + (es ? "Diseño y código del sitio" : "Website design and code") + " © " + year + "</div>";
      document.body.appendChild(card);
      requestAnimationFrame(function () { card.style.opacity = "1"; card.style.transform = "translate(-50%,0)"; });
      var hide = function () { card.style.opacity = "0"; card.style.transform = "translate(-50%,16px)"; setTimeout(function () { card.remove(); shown = false; }, 500); };
      card.addEventListener("click", hide);
      setTimeout(hide, 6000);
    }
  })();
</script>
